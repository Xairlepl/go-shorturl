APP_PORT=8080
BASE_URL=http://localhost:8080
MYSQL_DSN=root:root@tcp(localhost:3307)/shorturl?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=9
JWT_SECRET=change-me
JWT_TTL=24h
CACHE_TTL=1h
EMPTY_CACHE_TTL=1m
VISIT_FLUSH_INTERVAL=10s
GIN_MODE=debug
# 压测时设为 warn，关掉每请求的访问日志（否则 stdout I/O 会成为瓶颈）
LOG_LEVEL=info
